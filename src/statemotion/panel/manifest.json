{
  "manifestVersion": 5,
  "id": "io.github.anmol2k5.statemotion.panel",
  "name": "StateMotion",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "icons": [],
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "statemotion.panel",
      "label": "StateMotion",
      "minimumSize": {
        "width": 280,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 600
      }
    }
  ]
}
